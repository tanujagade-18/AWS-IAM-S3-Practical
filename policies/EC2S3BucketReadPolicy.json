{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListPracticalBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::tanuja-iam-s3-practical-2026"
    },
    {
      "Sid": "ReadPracticalBucketObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::tanuja-iam-s3-practical-2026/*"
    }
  ]
}
